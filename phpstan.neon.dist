parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - routes
    tmpDir: build/phpstan
    ignoreErrors:
        -
            # env() in a package's own config/*.php file is the correct, standard Laravel
            # pattern (the file itself IS "the config directory" once published into a host
            # app); Larastan's heuristic for locating the config path doesn't recognize a
            # package repo's own config/ directory as such.
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/laravel-bulk-upload-ui.php
